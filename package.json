{
  "name": "@soleone/factory",
  "version": "0.3.1",
  "description": "Works workwork candidates overnight and large goals as graphs of jobs, with headless coding agents, until the usage limits run out.",
  "keywords": [
    "agents",
    "claude-code",
    "cli",
    "coding-agent",
    "overnight",
    "pi"
  ],
  "homepage": "https://github.com/Soleone/factory#readme",
  "bugs": "https://github.com/Soleone/factory/issues",
  "license": "MIT",
  "author": "Soleone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soleone/factory.git"
  },
  "bin": {
    "factory": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node node_modules/vite/dist/vite/node/cli.js dev --mode demo",
    "build": "vp pack && vp build",
    "test": "vp test run",
    "check": "vp check",
    "release": "release-it",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@shadcn/lint": "^0.2.5",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "knip": "^6.45.1",
    "lucide-react": "^1.73.0",
    "markdown-to-jsx": "^9.10.6",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "release-it": "^21.1.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
